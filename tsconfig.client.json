{
  // Client-side typecheck for the browser half. Types come from the published
  // @deepseek-ai/dsh-client-* devDependencies, which track the DSH release line
  // the plugin targets — the same shape DSH uses for its own browser packages.
  "compilerOptions": {
    "target": "es2022",
    // `bundler` is what DSH itself uses for browser packages: those packages
    // expose their surface through a "./client" subpath export, which the
    // legacy `node` resolution cannot see. This is what the previous hardcoded
    // ../deepseek-harness paths worked around, at the cost of pinning the
    // typecheck to a sibling source checkout's directory layout.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-dom"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"],
  "exclude": ["lib", ".client-build", "node_modules"]
}
